{
  "flow_testnet_deployment": {
    "network_config": {
      "name": "flowTestnet",
      "rpc_url": "https://testnet.evm.nodes.onflow.org",
      "chain_id": 545,
      "currency": "FLOW",
      "block_explorer": "https://evm-testnet.flowscan.io",
      "faucet_url": "https://testnet-faucet.onflow.org"
    },
    "deployment_requirements": {
      "node_version": "18.x or higher (avoid 23.x due to Hardhat compatibility)",
      "required_tools": ["hardhat", "ethers", "@nomicfoundation/hardhat-toolbox"],
      "environment_variables": {
        "DEPLOY_WALLET_1": "Private key without 0x prefix",
        "ETHERSCAN_API_KEY": "Optional for contract verification"
      }
    },
    "hardhat_config": {
      "solidity_version": "0.8.24",
      "networks": {
        "flowTestnet": {
          "url": "https://testnet.evm.nodes.onflow.org",
          "accounts": ["${DEPLOY_WALLET_1}"],
          "chainId": 545
        }
      },
      "etherscan_config": {
        "apiKey": {
          "flowTestnet": "any-string"
        },
        "customChains": [
          {
            "network": "flowTestnet",
            "chainId": 545,
            "urls": {
              "apiURL": "https://evm-testnet.flowscan.io/api",
              "browserURL": "https://evm-testnet.flowscan.io/"
            }
          }
        ]
      }
    },
    "deployment_commands": {
      "compile": "npm run compile",
      "deploy_v1_marketplace": "npx hardhat run scripts/deploy-marketplace.js --network flowTestnet",
      "deploy_v1_academy": "npx hardhat run scripts/deploy-academy.js --network flowTestnet",
      "deploy_v2_membership_system": "npx hardhat run scripts/deploy-membership-v2.js --network flowTestnet",
      "verify_contracts": "node scripts/verify-membership-system.js",
      "test_deployment": "node scripts/test-membership-system.js"
    },
    "deployed_contracts": {
      "v1_contracts": {
        "AssetMarketplace": "0xc7403912b47Bd062E1933D40027088ACD5066deD",
        "RWAFlowToken": "0x6fBD4A26B44046716e37cD93Db5c47832E276AeB",
        "AcademyCertification": "0x66206f19Ca68C1B6286673ED3E7500AD50827df2",
        "AcademyNFT": "0xA5AC23d9f4EDc3068081D08214aa2D8fA7de7f4B"
      },
      "v2_contracts_account_abstraction": {
        "FlowPassportMembership": "0x04788614eecB86a9eEF39928D8dafBfAe54476a8",
        "FlowPassportRegistry": "0xdf03552Dd7afB410DE95E3c810AB7b39299904E7",
        "AcademyCertificationV2": "0x525715A1BcC513F66Eecea513652fc294833ef6C",
        "AssetMarketplaceV2": "0xc4951B1C022A29b4dCdbB3DE06e5C2f7A5767501"
      }
    },
    "contract_deployment_order": [
      {
        "step": 1,
        "contract": "FlowPassportMembership",
        "description": "Deploy master membership NFT contract",
        "constructor_args": ["deployer_address", "https://flowpassport.com/api/metadata/"],
        "script": "scripts/deploy-membership-v2.js"
      },
      {
        "step": 2,
        "contract": "FlowPassportRegistry",
        "description": "Deploy central registry for hierarchical relationships",
        "constructor_args": ["deployer_address", "membership_contract_address"],
        "dependencies": ["FlowPassportMembership"]
      },
      {
        "step": 3,
        "action": "link_contracts",
        "description": "Set registry contract in membership contract",
        "function": "setRegistryContract(registry_address)"
      },
      {
        "step": 4,
        "contract": "AcademyCertificationV2",
        "description": "Deploy enhanced academy with auto-membership",
        "constructor_args": ["deployer_address", "registry_contract_address"],
        "dependencies": ["FlowPassportRegistry"]
      },
      {
        "step": 5,
        "contract": "AssetMarketplaceV2",
        "description": "Deploy enhanced marketplace with auto-membership",
        "constructor_args": ["deployer_address", "registry_contract_address"],
        "dependencies": ["FlowPassportRegistry"]
      },
      {
        "step": 6,
        "action": "authorize_contracts",
        "description": "Authorize V2 contracts in registry",
        "functions": [
          "authorizeContract(academy_v2_address, true)",
          "authorizeContract(marketplace_v2_address, true)"
        ]
      }
    ],
    "deployment_best_practices": {
      "gas_optimization": "Use consistent deployer address to reduce gas costs",
      "retry_mechanism": "Implement exponential backoff for network timeouts",
      "verification_delay": "Wait 10-15 seconds before contract verification",
      "testing": "Always test basic functionality after deployment",
      "backup": "Save deployment info to JSON file with timestamps"
    },
    "common_issues": {
      "headers_timeout": {
        "error": "HeadersTimeoutError: Headers Timeout Error",
        "solution": "Implement retry mechanism with exponential backoff",
        "code_example": "await deployWithRetry(contractFactory, args, maxRetries=3)"
      },
      "verification_failure": {
        "error": "The address is not a smart contract",
        "solution": "Wait longer before verification or verify manually",
        "note": "Verification often fails immediately after deployment but contracts work fine"
      },
      "node_version_warning": {
        "warning": "Node.js v23.x not supported by Hardhat",
        "solution": "Use Node.js v18.x or v20.x for better compatibility"
      }
    },
    "frontend_integration": {
      "environment_variables": {
        "v2_contracts": {
          "NEXT_PUBLIC_MEMBERSHIP_CONTRACT_ADDRESS": "0x04788614eecB86a9eEF39928D8dafBfAe54476a8",
          "NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS": "0xdf03552Dd7afB410DE95E3c810AB7b39299904E7",
          "NEXT_PUBLIC_ACADEMY_V2_CONTRACT_ADDRESS": "0x525715A1BcC513F66Eecea513652fc294833ef6C",
          "NEXT_PUBLIC_MARKETPLACE_V2_CONTRACT_ADDRESS": "0xc4951B1C022A29b4dCdbB3DE06e5C2f7A5767501"
        },
        "network_config": {
          "NEXT_PUBLIC_FLOW_TESTNET_RPC": "https://testnet.evm.nodes.onflow.org",
          "NEXT_PUBLIC_FLOW_TESTNET_CHAIN_ID": "545"
        }
      }
    },
    "account_abstraction_features": {
      "master_membership_nft": {
        "description": "Soulbound NFT representing user's digital identity",
        "features": ["Reputation scoring", "Profile metadata", "Non-transferable"],
        "reputation_system": {
          "starting_score": 100,
          "certificate_bonus": 50,
          "asset_bonus": 25
        }
      },
      "hierarchical_nfts": {
        "description": "Child NFTs linked to master membership",
        "types": ["certificate", "asset"],
        "automatic_creation": "Created when user passes exam or purchases asset"
      },
      "unified_user_profile": {
        "description": "Single query returns complete user information",
        "includes": ["Membership info", "Certificates", "Assets", "Reputation"]
      }
    },
    "testing_flow": {
      "basic_deployment_test": [
        "Deploy all contracts in order",
        "Link contracts properly",
        "Authorize V2 contracts in registry",
        "Test membership creation",
        "Verify basic functionality"
      ],
      "integration_test": [
        "Create membership for test user",
        "Submit exam result (should auto-create certificate child NFT)",
        "Purchase asset (should auto-create asset child NFT)",
        "Query complete user profile",
        "Verify reputation updates"
      ]
    }
  }
}